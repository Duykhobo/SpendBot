# Môi trường chạy (development | production)
NODE_ENV=development

# Cổng cho Server Express
PORT=3000

# Khóa bảo mật cho JSON Web Token (JWT)
JWT_SECRET=your_super_secret_jwt_key_here

# Token của Telegram Bot (Lấy từ @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Chuỗi kết nối MongoDB Atlas (hoặc Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bottele?retryWrites=true&w=majority
